<section id="general" class="section">
  <div class="wrap">
    <h2 class="section-title">1. General information</h2>
    <div class="table-scroll">
      <table class="schedule info-table">
        <tbody>
          <tr><th scope="row">Course title</th><td>{{course.title}}</td></tr>
          <tr><th scope="row">Course code</th><td>{{course.code}}</td></tr>
          <tr><th scope="row">Type</th><td>{{course.type}}</td></tr>
          <tr><th scope="row">Credits / hours</th><td>{{course.credits}} credits · Lecture: {{course.hours.lecture}}h · Lab: {{course.hours.lab}}h · Self-study: {{course.hours.self_study}}h</td></tr>
          <tr><th scope="row">Prerequisites</th><td>{{#each course.prerequisites}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
