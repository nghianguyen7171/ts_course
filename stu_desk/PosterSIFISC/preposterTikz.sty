% Background image
\newcommand{\imgfundo}[1]{
\begin{tikzpicture}[remember picture,overlay]
  \tikzset{inner sep=0pt,outer sep=0pt}
    % Centered on the page
    \node at (current page.center) {
      \includegraphics[height=\paperheight]{#1} % Figure with paper height
    };
\end{tikzpicture}
}

% Simple plain header with logo
\newcommand{\titulo}[3]{
\noindent
\begin{minipage}{\textwidth}
\colorbox{#3}{%
  \parbox{\textwidth}{%
    % Logo in upper left corner
    \vspace{0.3cm}
    \noindent
    \includegraphics[height=2.0cm]{FDA logo.png}\hspace{0.5cm}
    \vspace{0.2cm}
    \centering
    {\Large\textbf{\textcolor{white}{\tituloposter}}}\\[0.5cm]
    {\Large\textbf{\textcolor{white}{\titulogrande}}}\\[0.8cm]
    % Handle multiple authors with \and separator
    {\large\textcolor{white}{\renewcommand{\and}{, }\nome}}\\[0.5cm]
    {\small\textcolor{white}{\instituicao}}
    \vspace{1.5cm}
  }%
}
\end{minipage}
}

% Conference name created with TikZ
\newcommand{\congresso}[1]{
\begin{tikzpicture}[remember picture,overlay]
\node at (current page.north){
  \begin{tikzpicture}[remember picture,overlay]
     \draw[fill=#1] (-.5*\textwidth-2cm,-13.25) rectangle (.5*\textwidth-2cm,-14.75);
     \node[white] at (-2cm,-14) {\Large{
	\nomecongresso \qquad --- \qquad \textbf{\abrev}
      }};
  \end{tikzpicture}
};
\end{tikzpicture}
}

% Footer created with TikZ
\newcommand{\rodape}[3]{
\begin{tikzpicture}[remember picture,overlay]
\node at (current page.south west){
  \begin{tikzpicture}[remember picture,overlay,inner sep=0,outer sep=0]
      \draw[fill=#3] (0,0) rectangle (\paperwidth,5);
      \node[above right] at (4cm,1) {
	\includegraphics[height=3cm]{#1} % Third logo (bottom left)
      };
  \end{tikzpicture}
};
\node[yshift=2cm,yellow] at (current page.south){\texttt{http://example.com}};
\node at (current page.south east){
  \begin{tikzpicture}[remember picture,overlay,inner sep=0,outer sep=0]
      \node[above left] at (-4cm,1) {
	\includegraphics[height=3cm]{#2} % Fourth logo (bottom right)
      };
  \end{tikzpicture}
};
\end{tikzpicture}
}