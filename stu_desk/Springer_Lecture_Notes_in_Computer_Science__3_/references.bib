% Sample Bibliography File (references.bib)
% This file contains example references in BibTeX format.
% Replace these with your actual references.
% Common entry types: article, inproceedings, book, inbook, misc

% Journal Article
@article{ref_article1,
  author  = {Author, F.},
  title   = {Article title},
  journal = {Journal Name},
  volume  = {2},
  number  = {5},
  pages   = {99--110},
  year    = {2016}
}

% Conference Paper (LNCS)
@inproceedings{ref_lncs1,
  author    = {Author, F. and Author, S.},
  title     = {Title of a proceedings paper},
  booktitle = {CONFERENCE 2016},
  editor    = {Editor, F. and Editor, S.},
  series    = {Lecture Notes in Computer Science},
  volume    = {9999},
  pages     = {1--13},
  publisher = {Springer},
  address   = {Heidelberg},
  year      = {2016},
  doi       = {10.10007/1234567890}
}

% Book
@book{ref_book1,
  author    = {Author, F. and Author, S. and Author, T.},
  title     = {Book title},
  edition   = {2nd},
  publisher = {Publisher Name},
  address   = {Location},
  year      = {1999}
}

% Conference Proceedings (without editors)
@inproceedings{ref_proc1,
  author    = {Author, A.-B.},
  title     = {Contribution title},
  booktitle = {9th International Proceedings on Proceedings},
  pages     = {1--2},
  publisher = {Publisher Name},
  address   = {Location},
  year      = {2010}
}

% Website/URL
@misc{ref_url1,
  author       = {{LNCS Homepage}},
  title        = {LNCS Homepage},
  howpublished = {\url{http://www.springer.com/lncs}},
  note         = {Last accessed: 2023/10/25}
}

